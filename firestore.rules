rules_version = '2';

// Sicherheitsregeln für PingHunt.
// In der Firebase-Konsole unter Firestore Database > Regeln komplett einfügen und veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function gameDoc(code) {
      return get(/databases/$(database)/documents/games/$(code));
    }

    function isLeader(code) {
      return signedIn() && (
        gameDoc(code).data.leaderUid == request.auth.uid ||
        exists(/databases/$(database)/documents/games/$(code)/leaders/$(request.auth.uid))
      );
    }

    function myTeam(code) {
      return get(/databases/$(database)/documents/games/$(code)/players/$(request.auth.uid)).data.get('teamId', null);
    }

    match /games/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leaderUid == request.auth.uid;
      allow update: if isLeader(code) && request.resource.data.leaderUid == resource.data.leaderUid;
      allow delete: if isLeader(code);

      // Leitungs-PIN: nur für die Spielleitung lesbar.
      match /secret/{doc} {
        allow read, write: if isLeader(code);
      }

      // Weitere Geräte der Spielleitung (über die PIN).
      match /leaders/{leaderId} {
        allow read: if signedIn() && (leaderId == request.auth.uid || isLeader(code));
        allow create: if signedIn() && leaderId == request.auth.uid &&
          request.resource.data.pin == get(/databases/$(database)/documents/games/$(code)/secret/main).data.pin;
        allow delete: if isLeader(code);
      }

      // Spieler: Team und Status ändert nur die Spielleitung.
      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn() && playerId == request.auth.uid &&
          request.resource.data.get('teamId', null) == null &&
          request.resource.data.get('status', 'free') == 'free';
        allow update: if isLeader(code) || (
          signedIn() && playerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamId', 'status'])
        );
        allow delete: if isLeader(code) || (signedIn() && playerId == request.auth.uid);
      }

      // Live-Positionen: nur das eigene Team und die Spielleitung.
      match /live/{playerId} {
        allow write: if signedIn() && playerId == request.auth.uid;
        allow read: if isLeader(code) || (
          signedIn() && resource.data.teamId != null && resource.data.teamId == myTeam(code)
        );
      }

      // Pings: für alle im Spiel sichtbar.
      match /pings/{pingId} {
        allow read: if signedIn();
        // Spieler schicken eigene Pings; die Spielleitung darf Ersatz-Pings (offline) anlegen.
        allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isLeader(code));
        allow update: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLeader(code);
      }

      // Jäger-Spur für Zuschauer (die App zeigt sie verzögert an).
      match /trail/{trailId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isLeader(code);
      }

      // Nachrichten: Durchsagen (all), privat mit der Spielleitung (dm:<uid>), Team-Chat (team:<teamId>).
      match /messages/{msgId} {
        // Lesen: alle angemeldeten Spieler; die App lädt nur die eigenen Kanäle.
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.from == request.auth.uid && (
          isLeader(code) || (
            request.resource.data.fromLeader == false && (
              request.resource.data.channel == 'dm:' + request.auth.uid ||
              request.resource.data.channel == 'team:' + string(myTeam(code))
            )
          )
        );
        allow delete: if isLeader(code);
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow delete: if isLeader(code);
      }
    }
  }
}
